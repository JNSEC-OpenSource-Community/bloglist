{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JNSEC Bloglist data",
  "type": "object",
  "required": ["version", "title", "description", "blogs"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "format": "uri-reference"
    },
    "blogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blog"
      }
    }
  },
  "$defs": {
    "blog": {
      "type": "object",
      "required": ["name", "homepage"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "feed": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
